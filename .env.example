# Public Expo configuration. These values are embedded in the client bundle.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
# Physical phone: use the computer's Wi-Fi IPv4 address, never localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# Restricted Android/iOS key used by the Expo native build configuration.
GOOGLE_MAPS_API_KEY=your-restricted-google-maps-key
