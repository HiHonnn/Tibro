GMAIL_USER=your-smtp-account@example.com
GMAIL_APP_PASSWORD=your-new-app-password
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-secret-key
OTP_SECRET=generate-a-long-random-secret

# Comma-separated web origins. Native mobile requests normally have no Origin.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Server-only LiveKit credentials. Never expose these as EXPO_PUBLIC_* values.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
